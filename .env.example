# ---------------------------------------------------------------------------
# ChatGangs configuration
# Copy to `.env` (or export as environment variables) and adjust as needed.
# Every value is read by chatgangs/config.py — nothing is hard-coded.
# ---------------------------------------------------------------------------

# --- application ------------------------------------------------------------
CHATGANGS_APP_NAME=ChatGangs
CHATGANGS_APP_VERSION=1.0.0
CHATGANGS_ENVIRONMENT=development          # development | test | production
CHATGANGS_DEBUG=false
CHATGANGS_DOCS_ENABLED=true                # expose /docs and /redoc
CHATGANGS_CORS_ORIGINS=*                   # comma separated list of origins

# --- security ---------------------------------------------------------------
# Comma separated API keys. Leave empty to disable key authentication.
CHATGANGS_API_KEYS=
CHATGANGS_REQUIRE_API_KEY=false
CHATGANGS_API_KEY_HEADER=X-API-Key
CHATGANGS_RATE_LIMIT_REQUESTS=120          # per window, per client
CHATGANGS_RATE_LIMIT_WINDOW_SECONDS=60
CHATGANGS_MAX_INPUT_CHARS=4000
CHATGANGS_MAX_MESSAGE_CHARS=2000
CHATGANGS_MAX_BATCH_SIZE=64
CHATGANGS_TRUST_FORWARDED_FOR=false        # enable behind a trusted proxy

# --- storage ----------------------------------------------------------------
CHATGANGS_DATABASE_URL=sqlite:///./data/chatgangs.db
# CHATGANGS_DATABASE_URL=postgresql+psycopg2://chatgangs:secret@localhost:5432/chatgangs
CHATGANGS_MODELS_DIR=models
CHATGANGS_DATA_DIR=data

# --- memory & privacy -------------------------------------------------------
CHATGANGS_MEMORY_ENABLED=true
CHATGANGS_MEMORY_PERSIST=true
CHATGANGS_MEMORY_MAX_TURNS=20
CHATGANGS_MEMORY_TTL_HOURS=72
CHATGANGS_MEMORY_STORE_USER_PROFILE=true

# --- NLP --------------------------------------------------------------------
CHATGANGS_DEFAULT_LANGUAGE=id
CHATGANGS_STEMMER_BACKEND=builtin          # builtin | sastrawi | auto
CHATGANGS_ENABLE_SPACY=true                # used only if the model is installed
CHATGANGS_SPACY_MODEL_EN=en_core_web_sm
CHATGANGS_SPACY_MODEL_ID=                  # opsional, model spaCy multibahasa
CHATGANGS_LANGUAGE_CONFIDENCE_THRESHOLD=0.55
CHATGANGS_INTENT_CONFIDENCE_THRESHOLD=0.30
CHATGANGS_MAX_TOKENS_PER_REQUEST=512
CHATGANGS_BOT_CONCURRENCY=8               # thread budget for CPU-bound calls
CHATGANGS_BOT_REQUESTS_PER_MINUTE=300     # soft per-client chat budget

# --- logging ----------------------------------------------------------------
CHATGANGS_LOG_LEVEL=INFO
CHATGANGS_LOG_JSON=false
CHATGANGS_LOG_CHAT_CONTENT=false           # never log message bodies by default
CHATGANGS_LOG_FILE=                        # kosong = hanya stdout/journald

# --- performance ------------------------------------------------------------
CHATGANGS_RESPONSE_CACHE_TTL_SECONDS=0
CHATGANGS_RESPONSE_CACHE_SIZE=256
CHATGANGS_NLP_CACHE_SIZE=2048
